# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://killeraste:killeraste@localhost:5432/killeraste
DATABASE_SYNC_URL=postgresql://killeraste:killeraste@localhost:5432/killeraste

# ── Redis (optional but recommended for rate-limiting state) ──────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Options: safe | normal | dry_run
INGESTION_MODE=safe
DRY_RUN=false
CONFIG_PATH=config/config.yaml

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ── Auth ─────────────────────────────────────────────────────────────────────
# Google OAuth client ID (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# JWT validity window (default: 24h)
JWT_EXPIRE_MINUTES=1440
# Frontend URL for CORS in production
FRONTEND_URL=https://your-frontend-domain.com

# ── Monitoring ────────────────────────────────────────────────────────────────
ENABLE_METRICS=true
OTLP_ENDPOINT=http://localhost:4317
