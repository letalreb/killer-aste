# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# Required in production (min 32 chars): openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://killeraste:killeraste@localhost:5432/killeraste
DATABASE_SYNC_URL=postgresql://killeraste:killeraste@localhost:5432/killeraste

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Options: safe | normal | dry_run
INGESTION_MODE=safe
DRY_RUN=false
CONFIG_PATH=config/config.yaml
# Disable when the host sleeps when idle and runs are triggered by an external cron
SCHEDULER_ENABLED=true
# Identifiable User-Agent sent to the sources (add a contact)
INGESTION_USER_AGENT=KillerAsteBot/1.0 (+https://github.com/letalreb/killer-aste)

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ── Auth ─────────────────────────────────────────────────────────────────────
# Google OAuth client ID (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# JWT validity window (default: 24h)
JWT_EXPIRE_MINUTES=1440
# Frontend URL for CORS in production
FRONTEND_URL=https://your-frontend-domain.com

# ── Monitoring ────────────────────────────────────────────────────────────────
ENABLE_METRICS=true
